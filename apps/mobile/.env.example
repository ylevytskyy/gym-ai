# Mobile app (Expo). Copy to .env and fill in.
# Every EXPO_PUBLIC_* value is built into the app and anyone can read it.
# Never put a secret here.

# local | staging | production
EXPO_PUBLIC_APP_ENV=local

# Supabase project URL. Local: printed by `supabase start`.
# On a real phone use your computer's LAN IP instead of 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key (sb_publishable_...). Safe to ship; Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI service base URL (services/assistant).
EXPO_PUBLIC_ASSISTANT_URL=http://127.0.0.1:3101

# RevenueCat public SDK key (appl_... / goog_...). It is the public SDK key, not a secret.
# Leave empty to run without billing: the app then skips RevenueCat entirely.
EXPO_PUBLIC_REVENUECAT_PUBLIC_KEY=
