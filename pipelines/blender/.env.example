# Blender pipeline (pipelines/blender). Copy to .env and fill in.
# Runs on a dev machine or in CI only. Never commit .env.

# Blender program. macOS default shown.
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# Where rendered files go.
OUTPUT_DIR=./out

# Upload results to Supabase Storage: true | false
UPLOAD=false
SUPABASE_URL=http://127.0.0.1:54321
# SECRET: secret key (sb_secret_...). Needed only when UPLOAD=true.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=exercise-media
