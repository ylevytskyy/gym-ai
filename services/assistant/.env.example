# AI service (services/assistant). Copy to .env and fill in.
# Server only. Never commit .env.

PORT=3101
# debug | info | warn | error
LOG_LEVEL=info

# Which provider answers live requests: openrouter | anthropic
ASSISTANT_PROVIDER=anthropic

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
# SECRET: secret key (sb_secret_...). Bypasses Row Level Security.
# Used only to save plans and by the background batch job.
SUPABASE_SECRET_KEY=

# --- OpenRouter (provider 2a) ---
# SECRET
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model id from https://openrouter.ai/models
OPENROUTER_MODEL=

# --- Anthropic (provider 2b) ---
# SECRET. The @anthropic-ai/sdk client reads this name by default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Background plans (Batch API) ---
BATCH_ENABLED=false
# When to build weekly plans (cron, server time). Default: Monday 02:00.
BATCH_CRON=0 2 * * 1
# How often to check a running batch, in seconds.
BATCH_POLL_SECONDS=60

# --- RevenueCat webhook (docs/revenuecat-webhook-spec.md) ---
# Signing secret of the RevenueCat webhook integration. Unset: POST /api/webhooks/revenuecat answers 503.
REVENUECAT_WEBHOOK_SECRET=
# Apply SANDBOX events. Set to true on dev and staging only.
REVENUECAT_ACCEPT_SANDBOX=false
# The RevenueCat entitlement identifier that means Pro.
REVENUECAT_PRO_ENTITLEMENT=pro
