# Supabase CLI. Copy to .env and fill in.
# Not needed for local dev (`supabase start` works without it).
# Needed to link, push migrations and deploy to the hosted project.

# SECRET: personal access token (dashboard > Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=
# Project reference id (the part before .supabase.co).
SUPABASE_PROJECT_REF=
# SECRET: database password, used by `supabase link` and `supabase db push`.
SUPABASE_DB_PASSWORD=

# --- Later: used from config.toml as env(NAME) ---
# SECRET: SMTP password for magic-link emails in production.
# SMTP_PASS=
# SECRET: Apple and Google sign-in.
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
